#!/usr/bin/env bash
set -euo pipefail

if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  echo "Remote commands are not allowed." >&2
  exit 1
fi

IFS= read -r event || {
  echo "Missing notification event." >&2
  exit 1
}

if [ "${event}" != "done" ]; then
  echo "Unsupported notification event." >&2
  exit 1
fi

uid=$(id -u)
export XDG_RUNTIME_DIR="/run/user/${uid}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

if [ ! -S "${XDG_RUNTIME_DIR}/bus" ]; then
  echo "No active desktop notification session for this user." >&2
  exit 1
fi

exec notify-send --app-name=OpenCode "作業完了" "OpenCodeの応答が完了しました。"
